# Production uses GROQ_API_KEY on the Vercel project (not committed).
# Local: put the same key in .env.local. One provider is enough:

AI_GATEWAY_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override Groq chat model if needed. llama-3.3-70b-versatile shut down 2026-08-16.
WHYWAIT_GROQ_MODEL=openai/gpt-oss-120b
WHYWAIT_MODEL=groq/openai/gpt-oss-120b
